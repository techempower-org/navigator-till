# Copy to .env (gitignored) or export in the shell. Nothing here is required for the mock demo.
MOCK=1                       # 0 = call the PayPal sandbox with the two keys below
PAYPAL_CLIENT_ID=            # from developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_SECRET=
ANTHROPIC_API_KEY=           # optional: Claude explains quotes; without it, templates do
NT_MODEL=claude-sonnet-5-5   # the model the explainer uses when a key is set
NT_ORG=TechEMPOWER
NT_ORG_EMAIL=hi@techempower.org
